<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="游园工具箱"
        android:icon="@drawable/youyuan_icon"
        android:roundIcon="@drawable/youyuan_icon"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true">

        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="org.youyuan.toolbox.updates"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <activity android:name="org.youyuan.toolbox.VerificationActivity" android:exported="false" />
        <service android:name="org.youyuan.toolbox.KeepService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service android:name="org.youyuan.toolbox.AccountProcessService$Slot1" android:process=":account1" android:exported="false" android:foregroundServiceType="specialUse" />
        <service android:name="org.youyuan.toolbox.AccountProcessService$Slot2" android:process=":account2" android:exported="false" android:foregroundServiceType="specialUse" />
        <service android:name="org.youyuan.toolbox.AccountProcessService$Slot3" android:process=":account3" android:exported="false" android:foregroundServiceType="specialUse" />
        <service android:name="org.youyuan.toolbox.AccountProcessService$Slot4" android:process=":account4" android:exported="false" android:foregroundServiceType="specialUse" />
