  yyPoolSyncTimeFacet();
  const rows = yyPoolFilteredRows(yyPoolRows, yyPoolQuery, yyPoolFilter, yyPoolTime, yyPoolRole, yyPoolPlayer);
  const grouped = yyPoolGroup === "player", groups = grouped ? yyPoolPlayerGroups(rows) : null;
