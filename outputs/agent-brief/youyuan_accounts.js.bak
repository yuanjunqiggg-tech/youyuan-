  const pageGroups = grouped ? groups.slice(start, start + yyPoolPageSize) : null;
  const shown = grouped ? pageGroups.reduce(function(list, group) { return list.concat(group.rows); }, []) : rows.slice(start, start + yyPoolPageSize);
